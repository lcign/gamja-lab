diff --git a/components/scroll-manager.js b/components/scroll-manager.js
index 13ee0e8..dda88df 100644
--- a/components/scroll-manager.js
+++ b/components/scroll-manager.js
@@ -68,9 +68,29 @@ export default class ScrollManager extends Component {
 		this.stickToBottom = this.isAtBottom();
 	}
 
+	scrollToBottom() {
+		let target = this.props.target.current;
+		if (target && target.firstChild) {
+			target.firstChild.scrollIntoView({ block: "end" });
+		}
+		this.stickToBottom = true;
+	}
+
+	// For whoever takes space away from us (the composer growing). Decide while the old
+	// layout is still there, pin once the new one is in: `stickToBottom` alone is not
+	// enough, a debounced scroll handler updates it and it lags by 100ms.
+	keepAtBottom() {
+		let stick = this.stickToBottom || this.isAtBottom();
+		return () => {
+			if (stick) {
+				this.scrollToBottom();
+			}
+		};
+	}
+
 	handleResize() {
-		if (this.stickToBottom && this.props.target.current.firstChild) {
-			this.props.target.current.firstChild.scrollIntoView({ block: "end" });
+		if (this.stickToBottom) {
+			this.scrollToBottom();
 		}
 	}
 
