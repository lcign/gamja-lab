emit a `gamja-list` event for LIST replies

LIST output is not surfaced anywhere, so a script on the page has no way to render a
channel list. Collect the replies and emit them at RPL_LISTEND; returning early keeps
the numerics out of the buffer.

diff --git a/components/app.js b/components/app.js
index 28e7c61..6b63cdd 100644
--- a/components/app.js
+++ b/components/app.js
@@ -1182,6 +1182,23 @@ export default class App extends Component {
 
 		let target, channel;
 		switch (msg.command) {
+		case irc.RPL_LISTSTART:
+			this.listReply = [];
+			return;
+		case irc.RPL_LIST:
+			this.listReply = this.listReply || [];
+			this.listReply.push({
+				c: msg.params[1],
+				u: parseInt(msg.params[2], 10) || 0,
+				t: msg.params[3] || "",
+			});
+			return;
+		case irc.RPL_LISTEND:
+			window.dispatchEvent(new CustomEvent("gamja-list", {
+				detail: this.listReply || [],
+			}));
+			this.listReply = null;
+			return;
 		case irc.RPL_WELCOME:
 			this.fetchBacklog(serverID);
 			break;
